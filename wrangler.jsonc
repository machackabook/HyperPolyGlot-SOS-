{
  "name": "cryptic-polyglot-public",
  "main": "src/cloudflare-public-worker.mjs",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}
